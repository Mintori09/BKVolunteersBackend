NODE_ENV=production
PORT=4000
SERVER_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com|https://admin.example.com

ACCESS_TOKEN_SECRET=replace-with-strong-access-token-secret
ACCESS_TOKEN_EXPIRE=20m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-token-secret
REFRESH_TOKEN_EXPIRE=1d
REFRESH_TOKEN_COOKIE_NAME=min

DATABASE_URL=mysql://root:replace-with-db-password@db-host:3306/BKVolunteers_prod
MYSQL_DATABASE=BKVolunteers_prod
MYSQL_ROOT_PASSWORD=replace-with-db-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=mailer@example.com

UPLOAD_BASE_PATH=uploads
UPLOAD_IMAGE_PATH=uploads/images
UPLOAD_DOCUMENT_PATH=uploads/documents
STATIC_URL_PREFIX=/files

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CALLBACK_URL=https://api.example.com/api/v1/auth/microsoft/callback
FRONTEND_URL=https://app.example.com

SEPAY_WEBHOOK_SECRET=replace-with-sepay-webhook-secret
